# Copy to .env and fill in. .env is git-ignored; never commit real credentials.

# --- Urja Meter Ops portal (required) ---
URJA_PORTAL_URL=https://urja-ops.flockenergy.tech
URJA_PORTAL_EMAIL=
URJA_PORTAL_PASSWORD=

# --- Portal client tuning (optional) ---
URJA_PORTAL_TIMEOUT_SECONDS=20
URJA_PORTAL_MAX_RETRIES=3
URJA_PORTAL_RETRY_BACKOFF_SECONDS=2

# How long the bulk meter snapshot is reused before re-fetching (seconds).
CACHE_TTL_SECONDS=300

# --- This service (optional) ---
# If set, every /api/* route except /api/health requires header X-API-Key with this value.
SERVICE_API_KEY=
LOG_LEVEL=INFO

# Set to 1 to run tests/test_live_portal.py against the real portal.
URJA_LIVE_TESTS=0
